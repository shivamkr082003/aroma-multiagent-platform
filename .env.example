GROQ_API_KEY=

DEEPGRAM_API_KEY=

TAVILY_API_KEY=

DATABASE_URL=postgresql://postgres:password@localhost:5432/aroma_db

REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333

# MCP: Fernet key that encrypts server headers/env (API keys) at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_SECRET_KEY=

# MCP: STDIO servers run a local process on the backend host. Keep off unless
# this backend is only used by you, and allowlist bare command names.
MCP_ALLOW_STDIO=false
MCP_STDIO_ALLOWED_COMMANDS=npx,uvx

# Auth: signs session tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_HOURS=168
# Local dev: keep these. If frontend and API are on different sites in
# production (e.g. Vercel + Render), use AUTH_COOKIE_SECURE=true and AUTH_COOKIE_SAMESITE=none.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Embeddings for document chat. "local" is free and runs on CPU (model downloads once, ~130 MB).
# Use "openai" (needs OPENAI_API_KEY) for text-embedding-3-small.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Document retrieval: dense_mmr (original) | dense | hybrid | hybrid_rerank (default, best in evaluation/run_eval.py)
RETRIEVAL_MODE=hybrid_rerank
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
